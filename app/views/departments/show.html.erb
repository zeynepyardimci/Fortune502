<div style="margin-bottom: 24px;">
  <%= link_to "← Departman Listesine Dön", departments_path, style: "color: var(--accent-cyan); text-decoration: none; font-size: 0.9rem;" %>
</div>

<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
  <div>
    <div style="display: flex; align-items: center; gap: 12px;">
      <h1 style="font-size: 2rem; font-weight: 700;"><%= @department.name %></h1>
      <span class="mono badge" style="background: rgba(6, 182, 212, 0.2); color: #22D3EE;"><%= @department.cost_center_code %></span>
    </div>
    <p style="color: var(--text-secondary); margin-top: 4px;">
      Sorumlu Yönetici: <strong style="color: var(--text-primary);"><%= @department.owner&.full_name || "Atanmamış" %></strong> (<%= @department.owner&.email || "-" %>)
    </p>
  </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
  <div class="card" style="margin-bottom: 0;">
    <div style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">Toplam Kredi Kotası</div>
    <div class="mono" style="font-size: 1.5rem; font-weight: 700; margin-top: 6px;"><%= @department.total_quota %></div>
  </div>
  <div class="card" style="margin-bottom: 0;">
    <div style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">Toplam Harcanan Kredi</div>
    <div class="mono" style="font-size: 1.5rem; font-weight: 700; margin-top: 6px; color: <%= @department.total_credits_used > @department.total_quota ? 'var(--status-throttled)' : 'var(--text-primary)' %>;"><%= @department.total_credits_used %></div>
  </div>
  <div class="card" style="margin-bottom: 0;">
    <div style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">Bütçe Kullanım Oranı</div>
    <div class="mono" style="font-size: 1.5rem; font-weight: 700; margin-top: 6px;"><%= @department.usage_percentage %>%</div>
  </div>
  <div class="card" style="margin-bottom: 0;">
    <div style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">Bağlı Sanal Ambar</div>
    <div class="mono" style="font-size: 1.5rem; font-weight: 700; margin-top: 6px;"><%= @warehouses.count %></div>
  </div>
</div>

<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <h2 style="font-size: 1.1rem; font-weight: 600;">Departmana Ait Sanal Ambarlar</h2>
    <%= link_to "+ Bu Departmana Ambar Ekle", new_warehouse_path(department_id: @department.id), class: "btn btn-outline", style: "font-size: 0.8rem; padding: 4px 10px;" %>
  </div>

  <table>
    <thead>
      <tr>
        <th>Ambar Adı</th>
        <th>Boyut</th>
        <th>Durum</th>
        <th>Kullanılan / Kota</th>
        <th>Kullanım %</th>
        <th>İşlem</th>
      </tr>
    </thead>
    <tbody>
      <% if @warehouses.any? %>
        <% @warehouses.each do |wh| %>
          <tr>
            <td style="font-weight: 600;">
              <%= link_to wh.name, warehouse_path(wh), style: "color: var(--text-primary); text-decoration: none;" %>
            </td>
            <td><span class="badge" style="background: rgba(255,255,255,0.05);"><%= wh.size.upcase %></span></td>
            <td><span class="badge badge-<%= wh.status %>"><%= wh.status %></span></td>
            <td class="mono"><%= wh.credits_used %> / <%= wh.credit_quota %></td>
            <td class="mono"><%= wh.usage_pct %>%</td>
            <td>
              <%= link_to "Görüntüle", warehouse_path(wh), class: "btn btn-outline", style: "padding: 3px 8px; font-size: 0.75rem;" %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-secondary); padding: 24px;">Bu departmana bağlı henüz bir sanal ambar bulunmuyor.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
